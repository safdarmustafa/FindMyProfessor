# FindMyProfessor — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Private Supabase Storage bucket for uploaded CV files. REQUIRED in
# production: without it CVs are written to the server's local disk, which
# Render wipes on every deploy/restart ("CV file is not available").
# Create it once (private, 10 MB limit) and use the same name everywhere.
SUPABASE_CV_BUCKET=cv-uploads

# ── Phase 3.2 / Phase 5 — Optional LLM (CV extraction and email drafting) ─
# Leave blank to use the deterministic provider (zero cost).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# EMAIL_LLM_API_KEY overrides LLM_API_KEY for email generation specifically.
EMAIL_LLM_API_KEY=
EMAIL_LLM_BASE_URL=
EMAIL_LLM_MODEL=

# ── Phase 6 — Google OAuth / Gmail ────────────────────────────────────────
#
# Setup steps:
#  1. Go to https://console.cloud.google.com/
#  2. Create a new project (or select an existing one).
#  3. Enable the Gmail API under APIs & Services → Library.
#  4. Configure OAuth consent screen:
#       - User type: External (for development)
#       - Add scope: https://www.googleapis.com/auth/gmail.send
#       - Add test users (your Gmail addresses for development)
#  5. Create OAuth credentials:
#       - Application type: Web application
#       - Add authorized redirect URI: http://localhost:8000/gmail/callback
#         (adjust port if needed; must exactly match GOOGLE_REDIRECT_URI below)
#  6. Copy Client ID and Client Secret here.
#  7. Start the FastAPI server and navigate to /outreach/compose/{professor_id}.
#
# IMPORTANT — Google OAuth verification:
#  During development you can add test users in the OAuth consent screen.
#  Public production use with sensitive scopes (gmail.send) may require
#  Google's OAuth app verification. Development/testing does NOT require it.
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# Token encryption key — used to encrypt OAuth tokens at rest in the database.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER hardcode this. NEVER commit it. NEVER share it.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Environment mode ──────────────────────────────────────────────────────
# Set to "production" to enforce stricter checks (e.g., require encryption key).
ENVIRONMENT=development
